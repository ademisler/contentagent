<?xml version="1.0"?>
<ruleset name="AI Content Agent">
  <description>WordPress Coding Standards for plugin PHP.</description>
  <file>plugin</file>
  <exclude-pattern>plugin/node_modules/*</exclude-pattern>
  <exclude-pattern>plugin/dist/*</exclude-pattern>
  <exclude-pattern>plugin/languages/*</exclude-pattern>
  <exclude-pattern>plugin/admin/assets/*</exclude-pattern>
  <rule ref="WordPress-Core"/>
  <rule ref="WordPress-Docs"/>
  <rule ref="WordPress-Extra"/>
</ruleset>